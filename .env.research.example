# 연구용 (research 브랜치) — .env.local 로 복사
# NEXT_PUBLIC_STANDALONE 는 넣지 마세요.

# Supabase (Vercel·PC·모바일 동기화 실험)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# KIS / DART / FRED / BOK — 선택 (아래 .env.local.example 과 동일)
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_USE_VTS=false
DART_API_KEY=
FRED_API_KEY=
BOK_API_KEY=
