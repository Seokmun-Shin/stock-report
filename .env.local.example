# 한국투자증권 KIS Open API (선택 — 현재가 자동 갱신)
# https://apiportal.koreainvestment.com 가입 후 App Key / Secret 발급
# Vercel·로컬 .env.local 에만 등록 (NEXT_PUBLIC_ 붙이지 마세요)
KIS_APP_KEY=
KIS_APP_SECRET=
# 모의투자 API 사용 시 true (실전 계좌 키면 false 또는 삭제)
KIS_USE_VTS=false

# DART Open API (선택 — 공시·기업 동향)
# https://opendart.fss.or.kr/ 회원가입 후 인증키 발급 (무료)
DART_API_KEY=

# FRED — 미국 연준 공식 경제지표 (선택, 무료)
# https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# 한국은행 ECOS — 한국 공식 경제지표 (선택, 무료)
# https://ecos.bok.or.kr/api/#/DevGuide/AuthKey
BOK_API_KEY=
